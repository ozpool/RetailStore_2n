# Postgres. Port 5433 matches docker-compose.yml, which maps the container's
# 5432 to 5433 on the host to avoid clashing with a native Postgres install.
DATABASE_URL="postgresql://retailstore_2n:retailstore_2n@localhost:5433/retailstore_2n?schema=public"

# Signs access tokens. Use a long random string; rotating it invalidates every
# active session.
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# Allowed CORS origin, and the base URL used to build email verification links.
FRONTEND_ORIGIN="http://localhost:3000"

# --- Uploads -----------------------------------------------------------------
# Where seller photos are written, and the public base URL they're served from.
# Defaults suit local development; point these at object storage / a CDN in
# production. See docs/architecture/lld.md for the storage seam.
# UPLOAD_DIR="./uploads"
# PUBLIC_UPLOAD_BASE="http://localhost:4000/uploads"

# --- Identity verification ---------------------------------------------------
# "stub"            — deterministic fake. Decides from a document number that
#                     passes through memory and is never stored.
# "stripe_identity" — real Stripe Identity. The seller uploads on Stripe's own
#                     domain, so no document reaches this process at all.
#                     Reuses STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET below
#                     — no second account needed.
#
# Note the stub is the WEAKER privacy model: it has to see a document number to
# decide anything. Switching to a real provider removes that field entirely.
# See docs/adr/0006-kyc-store-reference-not-document.md
KYC_PROVIDER="stub"

# --- Email -------------------------------------------------------------------
# MAIL_TRANSPORT picks how verification emails leave the building.
#
# "console"  (default) prints the link to this terminal. Nothing is sent. This
#            is what the test suites run against — 619 assertions should not
#            depend on an SMTP handshake.
# "ethereal" creates a throwaway inbox on demand and really sends to it. The
#            log line carries a URL where the rendered email can be read. No
#            account, no cost, no setup. Use this to demo or film the flow.
# "smtp"     a real server. Requires SMTP_HOST, SMTP_USER, SMTP_PASS, and the
#            server refuses to start without them rather than failing at the
#            first signup.
MAIL_TRANSPORT=console

# Shown as the sender. Real providers reject a From address on a domain you do
# not control, so set this to something you own before using "smtp".
MAIL_FROM=RetailStore_2n <no-reply@retailstore-2n.local>

# Only read when MAIL_TRANSPORT=smtp.
# Port defaults to 587. SMTP_SECURE defaults to true on 465 and false elsewhere,
# which is the right answer for almost every provider.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_SECURE=
